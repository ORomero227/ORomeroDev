---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImagesSlider from "../../components/ImagesSlider.astro";
import SignCTA from "../../components/SignCTA.astro";
import { formatDate, projectStatus } from "../../data/profile";

interface Props {
  entry: CollectionEntry<"project">;
}

export async function getStaticPaths() {
  const project = await getCollection("project");
  return project.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const status = projectStatus(data);
const images = data.images ?? (data.img ? [{ url: data.img, alt: data.img_alt }] : []);
---

<BaseLayout title={`${data.title} — Oscar Romero`} description={data.description}>
  <main class="container wrap">
    <a href="/project/" class="back">← All projects</a>

    <div class="window">
      <div class="window-bar">
        <div class="dots"><span></span><span></span><span></span></div>
        <span><strong>{data.title}</strong></span>
        <span class:list={["pill", status.tone]}>{status.label}</span>
      </div>

      <div class="layout">
        <article class="doc paper">
          <p class="kind">{data.projectType}</p>
          <h1>{data.title}</h1>
          <p class="desc">{data.description}</p>

          {images.length > 1 ? (
            <div class="media"><ImagesSlider images={images} /></div>
          ) : images.length === 1 ? (
            <div class="media single"><img src={images[0].url} alt={images[0].alt ?? data.title} /></div>
          ) : null}

          <div class="content">
            <Content />
          </div>
        </article>

        <aside class="meta">
          <dl>
            <div>
              <dt>Status</dt>
              <dd><span class:list={["pill", status.tone]}>{status.label}</span></dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{data.projectType}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd>{formatDate(data.publishDate)}</dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd>{data.tags.join(", ")}</dd>
            </div>
            {
              data.technologies && (
                <div>
                  <dt>Stack</dt>
                  <dd class="tags">
                    {data.technologies.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          <div class="actions">
            {
              data.liveUrl && (
                <a href={data.liveUrl} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                  Open live demo ↗
                </a>
              )
            }
            {
              data.githubCode && (
                <a href={data.githubCode} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                  View code on GitHub
                </a>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </main>

  <SignCTA />
</BaseLayout>

<style>
  .wrap {
    padding-top: 40px;
    padding-bottom: 120px;
  }

  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 20px;
  }

  .back:hover {
    color: var(--ink);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
  }

  .paper {
    background: #fff;
    margin: 16px;
    padding: 32px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
  }

  .kind {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.08;
    margin-bottom: 14px;
  }

  .desc {
    color: var(--ink-2);
    font-size: 19px;
  }

  .media {
    margin: 32px 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .media.single img {
    width: 100%;
  }

  /* Markdown content */
  .content {
    margin-top: 28px;
  }

  .content > :global(* + *) {
    margin-top: 14px;
  }

  .content :global(blockquote) {
    margin: 32px 0 10px;
    padding: 0;
    border: 0;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
  }

  .content :global(blockquote p) {
    margin: 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 20px;
  }

  .content :global(li + li) {
    margin-top: 6px;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .content :global(a) {
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  /* Sidebar */
  .meta {
    padding: 8px 16px 24px;
    font-size: 14px;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  dl > div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 12px;
    align-items: start;
  }

  dt {
    color: var(--muted);
    padding-top: 2px;
  }

  dd {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 300px;
    }
    .paper {
      margin: 32px 0 32px 32px;
      padding: 56px 64px;
    }
    .meta {
      padding: 32px 24px;
      margin-left: 32px;
      background: #fff;
      border-left: 1px solid var(--line);
    }
    .meta-inner {
      position: sticky;
      top: 88px;
    }
  }
</style>
