---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import SignCTA from "../components/SignCTA.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { profile, experience, skills } from "../data/profile";

const projects = (await getCollection("project", (p) => p.data.featured))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .slice(0, 3);

const current = experience.find((x) => x.current) ?? experience[0];

/**
 * Monospace fragments drifting in the hero's side gutters.
 * `type: true` makes a fragment type itself out on a loop.
 * Positions are percentages of the hero box.
 */
const snippets = [
  { text: "git push origin main", x: 1, y: 13, type: false },
  { text: "SELECT * FROM projects\nWHERE status = 'live';", x: 2, y: 27, type: true },
  { text: "npm run build", x: -1, y: 37, type: false },
  { text: "val picks = viewModel\n  .recommendations", x: 8, y: 55, type: false },
  { text: "dotnet ef database update", x: 4, y: 63, type: false },
  { text: "Deployed to production.\nAll checks passed.", x: 78, y: 9, type: false },
  { text: "Which tests are failing?", x: 90, y: 25, type: true },
  { text: "app.run(debug=False)", x: 84, y: 42, type: false },
  { text: "Make the API respond\nunder 200ms.", x: 89, y: 75, type: false },
];
---

<BaseLayout navVariant="dark">
  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="snippets" aria-hidden="true">
        {
          snippets.map((s, i) => (
            <pre
              class:list={["snip", s.type && "typing"]}
              style={`left:${s.x}%;top:${s.y}%;--d:${(i % 5) * 1.3}s`}
              data-text={s.text}
            >{s.text}</pre>
          ))
        }
      </div>

      <div class="container hero-inner">
        <h1 id="hero-title" class="headline">
          <span>Hi, I'm Oscar.</span>
          <span class="bright">{profile.role} in {profile.location}.</span>
        </h1>
        <p class="lead">{profile.summary}</p>

        <div class="hero-actions">
          <a href={`mailto:${profile.email}`} class="hbtn hbtn-solid">Contact me</a>
          <a href="#work" class="hbtn hbtn-soft">
            <svg width="11" height="12" viewBox="0 0 11 12" aria-hidden="true"
              ><path d="M0 0.5v11L10.5 6z" fill="currentColor"></path></svg
            >
            See my work
          </a>
          <a href={profile.cv} target="_blank" rel="noopener" class="hbtn hbtn-soft">Download CV</a>
        </div>
      </div>
    </section>

    <!-- Feature cards overlap the bottom of the gradient -->
    <div class="container features">
      <FeatureCard
        id="work"
        title="Selected work"
        description="Web, mobile, desktop and automation projects — each one shipped end to end."
      >
        <div class="pane-bar">
          <span>Featured projects</span>
          <a href="/project/" class="all-link">Browse all projects →</a>
        </div>
        <ul class="rows">
          {projects.map((p) => <ProjectRow project={p} />)}
        </ul>
      </FeatureCard>

      <FeatureCard
        title="Where I work now"
        description={`${current.role} at ${current.company} since ${current.start}.`}
      >
        <div class="now">
          <ul class="now-list">
            {current.highlights.slice(0, 4).map((h) => <li>{h}</li>)}
          </ul>
          <a href="/about/" class="all-link">Full experience &amp; education →</a>
        </div>
      </FeatureCard>

      <FeatureCard
        title="Skills"
        description="The stack I reach for across web, mobile and backend."
      >
        <div class="skills">
          {
            skills.map((s) => (
              <div class="srow">
                <p class="scat">{s.category}</p>
                <div class="sitems">
                  {s.items.map((i) => (
                    <span class="tag">{i}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </FeatureCard>
    </div>

    <SignCTA />
  </main>
</BaseLayout>

<script>
  // Type-out loop for a few hero snippets.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>(".snip.typing").forEach((el, n) => {
      const full = el.dataset.text ?? "";
      let i = 0;
      let dir = 1;
      const tick = () => {
        i += dir;
        el.textContent = full.slice(0, i);
        let wait = 55 + Math.random() * 60;
        if (i >= full.length) {
          dir = -1;
          wait = 2600;
        } else if (i <= 0) {
          dir = 1;
          wait = 900;
        } else if (dir < 0) {
          wait = 22;
        }
        setTimeout(tick, wait);
      };
      el.textContent = "";
      setTimeout(tick, 600 + n * 900);
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding-top: 200px;
    padding-bottom: 260px;
    background: linear-gradient(
      180deg,
      #2b0607 0%,
      #3a0909 18%,
      #521009 34%,
      #8a1d0c 50%,
      #c8330f 62%,
      #ec5a2a 70%,
      #f6a98c 80%,
      #fde7de 90%,
      #ffffff 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1000px;
  }

  .headline {
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
  }

  .headline span {
    display: block;
  }

  .headline .bright {
    color: #fff;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 64px;
  }

  .hbtn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 36px;
    padding: 0 11px;
    border-radius: 5px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .hbtn-solid {
    background: #fff;
    color: var(--ink);
  }

  .hbtn-solid:hover {
    background: #f1ece9;
  }

  .hbtn-soft {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .hbtn-soft:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  /* Floating mono fragments */
  .snippets {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: none;
  }

  .snip {
    position: absolute;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.5);
    white-space: pre;
    animation: drift 9s ease-in-out var(--d) infinite alternate;
  }

  .snip.typing::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 12px;
    margin-left: 1px;
    vertical-align: -2px;
    background: rgba(255, 255, 255, 0.8);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes drift {
    from {
      transform: translateY(0);
      opacity: 0.55;
    }
    to {
      transform: translateY(-10px);
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 1100px) {
    .snippets {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snip {
      animation: none;
    }
  }

  /* ---------- Feature cards ---------- */
  .features {
    position: relative;
    z-index: 2;
    margin-top: -180px;
    display: grid;
    gap: 96px;
    padding-bottom: 140px;
    max-width: 1000px;
  }

  .lead {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    max-width: 58ch;
  }

  .pane-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 18px;
    font-size: 13px;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }

  .all-link {
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  .all-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now {
    padding: 24px;
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .now-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .now-list li::marker {
    color: var(--faint);
  }

  .srow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding: 16px 24px;
  }

  .srow + .srow {
    border-top: 1px solid var(--line);
  }

  .scat {
    font-size: 14px;
    color: var(--muted);
    width: 120px;
  }

  .sitems {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (min-width: 860px) {
    .now {
      padding: 36px 44px 44px;
    }
    .srow {
      padding: 18px 44px;
    }
    .hero {
      padding-top: 240px;
      padding-bottom: 300px;
    }
    .features {
      margin-top: -220px;
      gap: 120px;
    }
  }
</style>
