---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Not found — Oscar Romero" description="404 — this page was not found" navVariant="dark">
  <main>
    <PageHero eyebrow="404" muted="This page was never signed." title="It doesn't exist, or it moved.">
      <div class="actions">
        <a href="/" class="hbtn hbtn-solid">Back home</a>
        <a href="/project/" class="hbtn hbtn-soft">See projects</a>
      </div>
    </PageHero>
  </main>
</BaseLayout>

<style>
  main {
    padding-bottom: 80px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 40px;
  }
</style>
