---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import SignCTA from "../components/SignCTA.astro";
import PageHero from "../components/PageHero.astro";

const projects = (await getCollection("project")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const types = ["All", ...new Set(projects.map((p) => p.data.projectType))];
---

<BaseLayout title="Projects — Oscar Romero" description="Everything Oscar Romero has built." navVariant="dark">
  <main>
    <PageHero
      eyebrow={`${projects.length} projects`}
      muted="Web, mobile, desktop."
      title="Everything I've built."
      lead="Click any project to open the full write-up, screenshots and code."
      overlap
    />

    <section class="container list-wrap">
      <div class="window">
        <div class="window-bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <span><strong>oromero</strong> / projects</span>
          <span class="count" data-count>{projects.length} shown</span>
        </div>
        <div class="filters" role="tablist" aria-label="Filter by type">
          {
            types.map((t, i) => (
              <button type="button" class="filter" role="tab" aria-selected={i === 0 ? "true" : "false"} data-type={t}>
                {t}
              </button>
            ))
          }
        </div>
        <ul class="rows" data-rows>
          {
            projects.map((p) => <ProjectRow project={p} showThumb />)
          }
        </ul>
      </div>
    </section>

    <SignCTA />
  </main>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const rows = document.querySelectorAll<HTMLElement>("[data-rows] > li");
  const count = document.querySelector("[data-count]");
  filters.forEach((btn) =>
    btn.addEventListener("click", () => {
      const t = btn.dataset.type;
      filters.forEach((b) => b.setAttribute("aria-selected", b === btn ? "true" : "false"));
      let n = 0;
      rows.forEach((r) => {
        const show = t === "All" || r.dataset.kind === t;
        r.hidden = !show;
        if (show) n++;
      });
      if (count) count.textContent = `${n} shown`;
    })
  );
</script>

<style>
  .list-wrap {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin-top: -200px;
    padding-bottom: 120px;
  }

  .list-wrap .window {
    border-radius: 18px;
    box-shadow: 0 30px 80px -30px rgba(60, 10, 5, 0.25), 0 2px 8px -2px rgba(0, 0, 0, 0.05);
  }

  .count {
    font-size: 12px;
    color: var(--faint);
  }

  .filters {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter {
    flex: none;
    font: inherit;
    font-size: 13px;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--muted);
    cursor: pointer;
  }

  .filter[aria-selected="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

</style>
