---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignCTA from "../components/SignCTA.astro";
import { profile, education, skills } from "../data/profile";
---

<BaseLayout title="About — Oscar Romero" description="About Oscar Romero, full-stack developer in Puerto Rico.">
  <main>
    <section class="container head">
      <p class="eyebrow">About</p>
      <h1>
        <span class="faint">Hi, I'm Oscar.</span>
        {profile.role} in {profile.location}.
      </h1>
      <p class="lead">{profile.summary}</p>
      <div class="actions">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">Contact me</a>
        <a href={profile.cv} target="_blank" rel="noopener" class="btn btn-outline">Download CV</a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
      </div>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Education &amp; certifications</h2>
      </div>
      <ul class="table">
        {
          education.map((e) => (
            <li class="trow">
              <div class="tmain">
                <p class="ttitle">{e.title}</p>
                <p class="tsub">{e.institution}</p>
                {e.description && <p class="tdesc">{e.description}</p>}
              </div>
              <div class="tside">
                <span class="tdate">{e.date}</span>
                <span class="pill pill-green">{e.status}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Skills</h2>
      </div>
      <div class="table skills">
        {
          skills.map((s) => (
            <div class="srow">
              <p class="scat">{s.category}</p>
              <div class="sitems">
                {s.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <SignCTA />
  </main>
</BaseLayout>

<style>
  .head {
    padding-top: 72px;
    padding-bottom: 80px;
  }

  h1 {
    font-size: clamp(36px, 5.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 12px 0 20px;
    max-width: 16ch;
  }

  .faint {
    color: var(--faint);
  }

  .lead {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }

  .block {
    padding-bottom: 72px;
  }

  .block-head h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }

  .table {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .trow,
  .srow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 20px;
  }

  .trow + .trow,
  .srow + .srow {
    border-top: 1px solid var(--line);
  }

  .ttitle {
    font-weight: 500;
  }

  .tsub,
  .tdesc {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 2px;
  }

  .tdesc {
    max-width: 60ch;
    margin-top: 6px;
  }

  .tside {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }

  .srow {
    align-items: center;
  }

  .scat {
    font-size: 14px;
    color: var(--muted);
    width: 120px;
  }

  .sitems {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
