---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignCTA from "../components/SignCTA.astro";
import PageHero from "../components/PageHero.astro";
import { profile, experience, education, skills } from "../data/profile";
---

<BaseLayout title="About — Oscar Romero" description="About Oscar Romero, full-stack developer in Puerto Rico." navVariant="dark">
  <main>
    <PageHero
      eyebrow="About"
      muted="Hi, I'm Oscar."
      title={`${profile.role} in ${profile.location}.`}
      lead={profile.summary}
    >
      <div class="actions">
        <a href={`mailto:${profile.email}`} class="hbtn hbtn-solid">Contact me</a>
        <a href={profile.cv} target="_blank" rel="noopener" class="hbtn hbtn-soft">Download CV</a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="hbtn hbtn-soft">LinkedIn</a>
      </div>
    </PageHero>

    <section class="container block" id="experience">
      <div class="block-head">
        <h2>Experience</h2>
      </div>
      <ol class="table timeline">
        {
          experience.map((x) => (
            <li class="trow xrow">
              <span class:list={["dot", x.current && "dot-current"]} aria-hidden="true" />
              <div class="tmain">
                <p class="ttitle">{x.role}</p>
                <p class="tsub">
                  {x.company}
                  {x.location && <> · {x.location}</>}
                </p>
                <ul class="xlist">
                  {x.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
              <div class="tside">
                <span class="tdate">
                  {x.start} – {x.end}
                </span>
                {x.current && <span class="pill pill-green">Current</span>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Education &amp; certifications</h2>
      </div>
      <ul class="table">
        {
          education.map((e) => (
            <li class="trow">
              <div class="tmain">
                <p class="ttitle">{e.title}</p>
                <p class="tsub">{e.institution}</p>
                {e.description && <p class="tdesc">{e.description}</p>}
              </div>
              <div class="tside">
                <span class="tdate">{e.date}</span>
                <span class="pill pill-green">{e.status}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Skills</h2>
      </div>
      <div class="table skills">
        {
          skills.map((s) => (
            <div class="srow">
              <p class="scat">{s.category}</p>
              <div class="sitems">
                {s.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <SignCTA />
  </main>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 40px;
  }

  .block {
    max-width: 1000px;
    padding-bottom: 72px;
  }

  .block-head h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }

  .table {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .trow,
  .srow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 20px;
  }

  .trow + .trow,
  .srow + .srow {
    border-top: 1px solid var(--line);
  }

  .ttitle {
    font-weight: 500;
  }

  .tsub,
  .tdesc {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 2px;
  }

  .tdesc {
    max-width: 60ch;
    margin-top: 6px;
  }

  .tside {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }

  .srow {
    align-items: center;
  }

  /* Experience timeline: a rail with one dot per role */
  .xrow {
    position: relative;
    padding-left: 44px;
    align-items: flex-start;
  }

  .xrow::before {
    content: "";
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .xrow:first-child::before {
    top: 26px;
  }

  .xrow:last-child::before {
    bottom: calc(100% - 26px);
  }

  .dot {
    position: absolute;
    left: 20px;
    top: 22px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line-strong);
  }

  .dot-current {
    background: var(--green);
    border-color: var(--green);
    box-shadow: 0 0 0 4px var(--green-bg);
  }

  .xrow .tmain {
    flex: 1 1 420px;
    min-width: 0;
  }

  .xlist {
    margin: 10px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 4px;
    color: var(--ink-2);
    font-size: 14.5px;
    max-width: 64ch;
  }

  .xrow .tside {
    white-space: nowrap;
  }

  .scat {
    font-size: 14px;
    color: var(--muted);
    width: 120px;
  }

  .sitems {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
