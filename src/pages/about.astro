---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignCTA from "../components/SignCTA.astro";
import PageHero from "../components/PageHero.astro";
import { profile, experience, education, skills } from "../data/profile";
---

<BaseLayout title="About — Oscar Romero" description="About Oscar Romero, full-stack developer in Puerto Rico." navVariant="dark">
  <main>
    <PageHero
      eyebrow="About"
      muted="Hi, I'm Oscar."
      title={`${profile.role} in ${profile.location}.`}
      lead={profile.summary}
    >
      <div class="actions">
        <a href={`mailto:${profile.email}`} class="hbtn hbtn-solid">Contact me</a>
        <a href={profile.cv} target="_blank" rel="noopener" class="hbtn hbtn-soft">Download CV</a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="hbtn hbtn-soft">LinkedIn</a>
      </div>
    </PageHero>

    <section class="container block">
      <div class="block-head">
        <h2>Experience</h2>
      </div>
      <ol class="table timeline">
        {
          experience.map((x) => (
            <li class="xrow">
              <div class="xhead">
                <p class="ttitle">
                  {x.company} <span class="xrole">— {x.role}</span>
                </p>
                <div class="tside">
                  <span class="tdate">{x.start} – {x.end}</span>
                  {x.current && <span class="pill pill-green">Current</span>}
                </div>
              </div>
              <ul class="xlist">
                {x.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Education &amp; certifications</h2>
      </div>
      <ul class="table">
        {
          education.map((e) => (
            <li class="trow">
              <div class="tmain">
                <p class="ttitle">{e.title}</p>
                <p class="tsub">{e.institution}</p>
                {e.description && <p class="tdesc">{e.description}</p>}
                {e.credentialUrl && (
                  <a href={e.credentialUrl} target="_blank" rel="noopener" class="tlink">
                    Verify on Credly ↗
                  </a>
                )}
              </div>
              <div class="tside">
                <span class="tdate">{e.date}</span>
                <span class="pill pill-green">{e.status}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container block">
      <div class="block-head">
        <h2>Skills</h2>
      </div>
      <div class="table skills">
        {
          skills.map((s) => (
            <div class="srow">
              <p class="scat">{s.category}</p>
              <div class="sitems">
                {s.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <SignCTA />
  </main>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 40px;
  }

  .block {
    max-width: 1000px;
    padding-bottom: 72px;
  }

  .block-head h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }

  .table {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .trow,
  .srow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 20px;
  }

  .trow + .trow,
  .srow + .srow {
    border-top: 1px solid var(--line);
  }

  .ttitle {
    font-weight: 500;
  }

  .tsub,
  .tdesc {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 2px;
  }

  .tdesc {
    max-width: 60ch;
    margin-top: 6px;
  }

  .tlink {
    display: inline-block;
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .tlink:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tside {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }

  .timeline {
    padding: 0;
  }

  .xrow {
    padding: 20px;
  }

  .xrow + .xrow {
    border-top: 1px solid var(--line);
  }

  .xhead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 10px;
  }

  .xrole {
    color: var(--muted);
    font-weight: 400;
  }

  .xlist {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .xlist li::marker {
    color: var(--faint);
  }

  .srow {
    align-items: center;
  }

  .scat {
    font-size: 14px;
    color: var(--muted);
    width: 120px;
  }

  .sitems {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
