---
import { profile } from "../data/profile";

const links = [
  { label: "Projects", href: "/project/" },
  { label: "About", href: "/about/" },
  { label: "CV", href: profile.cv, external: true },
];

interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && path.startsWith(href);
---

<header class:list={["nav", variant === "dark" && "on-dark"]}>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Oscar Romero — home">
      <span class="mark">/</span>
      <span class="brand-name">oromero</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav-link"
                aria-current={isCurrent(l.href) ? "page" : undefined}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={profile.github} class="btn btn-ghost btn-sm hide-sm" target="_blank" rel="noopener">GitHub</a>
      <a href={`mailto:${profile.email}`} class="btn btn-primary btn-sm nav-cta">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
  }

  .mark {
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0 6px 0 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link[aria-current="page"] {
    color: var(--ink);
    background: var(--surface-2);
  }

  /* Transparent nav over the dark hero */
  .on-dark {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: #fff;
  }

  .on-dark .nav-inner {
    height: 96px;
    max-width: 1000px;
  }

  .on-dark .nav-link {
    color: rgba(255, 255, 255, 0.62);
  }

  .on-dark .nav-link:hover {
    color: #fff;
  }

  .on-dark .nav-link[aria-current="page"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .on-dark .btn-ghost {
    color: #fff;
  }

  .on-dark .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .on-dark .nav-cta {
    background: transparent;
    color: #fff;
    padding: 0 8px;
  }

  .on-dark .nav-cta:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .on-dark .btn-ghost {
    padding: 0 8px;
  }

  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
    .brand-name {
      display: none;
    }
    .nav-link {
      padding: 0 8px;
    }
  }
</style>
