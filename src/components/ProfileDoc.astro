---
import { profile, skills, education, experience } from "../data/profile";

const [currentRole] = experience.filter((x) => x.current);
const previous = experience.filter((x) => !x.current);
---

<div class="window pdoc">
  <div class="window-bar">
    <div class="dots"><span></span><span></span><span></span></div>
    <span><strong>Developer profile</strong></span>
    <span class="saved">Saved</span>
  </div>

  <div class="pdoc-body">
    <article class="doc paper">
      <h3>Developer profile</h3>
      <p class="parties">Oscar Romero &amp; You</p>

      <p>
        This profile is between <strong>{profile.name}</strong> (the Developer) and
        <strong>you</strong> (the Reader).
      </p>

      <h4>1. Scope of work</h4>
      <p>
        The Developer will design, build and ship software for the <strong>web</strong>,
        <strong>Android</strong> and the <strong>backend</strong>, including clean, maintainable
        code and as many rounds of revisions as it takes.
      </p>

      <h4>2. Experience</h4>
      <p>
        The Developer currently serves as <strong>{currentRole.role}</strong> at
        <strong>{currentRole.company}</strong> ({currentRole.start} – {currentRole.end}), working on
        core banking, digital channels, an API gateway and an AWS-hosted rebate system.
        Previously: {previous.map((x) => `${x.role} at ${x.company}`).join("; ")}.
      </p>

      <h4>3. Stack</h4>
      <dl class="stack">
        {
          skills.map((s) => (
            <div>
              <dt>{s.category}</dt>
              <dd>{s.items.join(", ")}</dd>
            </div>
          ))
        }
      </dl>

      <h4>4. Education</h4>
      <ul class="edu">
        {
          education.map((e) => (
            <li>
              <strong>{e.title}</strong>, {e.institution}. <span class="when">{e.date}</span>
            </li>
          ))
        }
      </ul>

      <h4>5. Availability</h4>
      <p>
        <span class="clause" data-clause
          >The Developer is <s class="old">not currently looking</s>
          <span class="new">open to new projects and collaborations</span>, effective
          immediately.</span
        >
      </p>
    </article>

    <aside class="comments" aria-label="Comments">
      <div class="c-head">
        <span>Comments</span>
        <span class="c-count">1 open</span>
      </div>

      <div class="c-card c1">
        <p class="c-ref">Selected section · 5. Availability</p>
        <p class="c-author"><strong>Recruiter</strong> <span>Just now</span></p>
        <p>Are you open to new projects? We have something full-stack.</p>
      </div>

      <div class="c-card c2">
        <p class="c-author"><strong>Oscar Romero</strong> <span>Just now</span></p>
        <p>Always happy to talk. I've updated my availability.</p>
        <p class="c-update">Availability updated to <strong>open</strong>.</p>
      </div>

      <a href={`mailto:${profile.email}`} class="btn btn-primary btn-sm c3">Resolve — send a message</a>
    </aside>
  </div>
</div>

<style>
  .saved {
    font-size: 12px;
    color: var(--faint);
  }

  .pdoc-body {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
  }

  .paper {
    background: #fff;
    margin: 20px;
    padding: 32px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 17px;
  }

  .paper h3 {
    font-size: 28px;
    margin-bottom: 4px;
  }

  .parties {
    color: var(--muted);
    margin-bottom: 20px;
    font-size: 16px;
  }

  .paper h4 {
    font-size: 19px;
    margin: 26px 0 8px;
  }

  .stack {
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .stack div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  .stack dt {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 13px;
    padding-top: 4px;
  }

  .stack dd {
    margin: 0;
  }

  .edu {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }

  .when {
    color: var(--muted);
  }

  .clause {
    border-radius: 3px;
    transition: background-color 0.4s ease;
  }

  .old {
    color: var(--faint);
  }

  .new {
    background: var(--green-bg);
    color: var(--green);
    border-radius: 3px;
    padding: 0 2px;
  }

  /* Comments */
  .comments {
    padding: 0 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }

  .c-head {
    display: flex;
    justify-content: space-between;
    font-weight: 500;
    padding: 4px 2px;
  }

  .c-count {
    color: var(--muted);
    font-weight: 400;
  }

  .c-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
  }

  .c-ref {
    font-size: 12px;
    color: var(--muted);
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--line);
  }

  .c-author {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .c-author strong {
    color: var(--ink);
    font-weight: 600;
  }

  .c-author span {
    color: var(--faint);
    font-size: 12px;
  }

  .c-update {
    font-size: 13px;
    color: var(--green);
  }

  .c3 {
    align-self: flex-start;
  }

  /* Sequenced entrance once the section is visible */
  .c1,
  .c2,
  .c3 {
    opacity: 0;
    transform: translateY(6px);
  }

  :global(.is-visible) .c1,
  :global(.is-visible) .c2,
  :global(.is-visible) .c3 {
    animation: rise 0.5s ease forwards;
  }

  :global(.is-visible) .c1 {
    animation-delay: 0.5s;
  }
  :global(.is-visible) .c2 {
    animation-delay: 1.6s;
  }
  :global(.is-visible) .c3 {
    animation-delay: 2.4s;
  }

  .old,
  .new {
    transition: opacity 0.4s ease;
  }

  :global(.is-visible) .clause {
    animation: highlight 2.4s ease 0.3s both;
  }

  @keyframes highlight {
    0%,
    70% {
      background: #fff6c2;
    }
    100% {
      background: transparent;
    }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .c1,
    .c2,
    .c3 {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }

  @media (min-width: 900px) {
    .pdoc-body {
      grid-template-columns: 1fr 300px;
    }
    .paper {
      margin: 32px 0 32px 32px;
      padding: 48px 56px;
    }
    .comments {
      padding: 32px 24px;
      border-left: 1px solid var(--line);
      margin-left: 32px;
      background: #fff;
    }
  }
</style>
